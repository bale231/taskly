{
  "expo": {
    "name": "Taskly",
    "slug": "taskly",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "taskly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bale231.taskly",
      "icon": "./assets/ios-icon-taskly.png",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Taskly usa la libreria foto per aggiornare la tua immagine del profilo.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bale231.taskly",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-taskly.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          },
          "android": {
            "image": "./assets/android-icon-taskly.png",
            "backgroundColor": "#000000",
            "dark": {
              "backgroundColor": "#000000"
            }
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3fedb040-d1da-41a2-ab2d-b14f9deed9aa"
      }
    }
  }
}
